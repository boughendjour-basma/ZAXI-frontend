# Backend API Base URL (e.g., https://api.zaxi.dz or https://zaxi-api.onrender.com)
VITE_API_URL=http://localhost:3000

# Backend Socket.IO Server URL (usually matches API base URL)
VITE_SOCKET_URL=http://localhost:3000

# Google Maps JavaScript API Key (required for real-time map tracking & autocomplete)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
